# Copy to .env (git-ignored) or export the variables. All values here are examples.

# --- Exchange (EWS) ---------------------------------------------------------
EWS_SERVER_URL=https://mail.example.com/EWS/Exchange.asmx
EWS_EMAIL=user@example.com
# Login name if it differs from the address (e.g. DOMAIN\user or a UPN); default: EWS_EMAIL
EWS_USERNAME=
EWS_PASSWORD=
# true only for test servers with self-signed certificates
EWS_INSECURE_SKIP_VERIFY=false
# IANA timezone used to interpret 'today', '+1d', naive times and to render dates
EWS_TZ=UTC

# --- Safety -----------------------------------------------------------------
# read  = read tools only (15)
# draft = + drafts, message/event/task edits (23)   [default]
# full  = + send_draft, respond_to_event, cancel_event, delete_messages, set_oof (28)
EWS_CAPABILITY_TIER=draft
# Kill-switch for everything that leaves the mailbox (send, meeting replies,
# invitations, cancellations, out-of-office). Default false.
SEND_ENABLED=false
# Recipient guard: comma-separated globs, case-insensitive (fnmatch).
# Allowlist empty = any recipient allowed; denylist always wins.
EWS_RECIPIENT_ALLOWLIST=
# e.g. EWS_RECIPIENT_ALLOWLIST=*@example.com,partner@example.org
EWS_RECIPIENT_DENYLIST=
# HMAC secret for two-phase confirm tokens. Empty = random per process
# (tokens then die on restart, which is fine).
SEND_CONFIRM_SECRET=
CONFIRM_TTL_SECONDS=600

# --- Reliability ------------------------------------------------------------
# Circuit breaker: after N consecutive Exchange failures, refuse EWS calls for M seconds
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=60
# Startup warmup retries with exponential backoff up to this many seconds
WARMUP_MAX_BACKOFF_SECONDS=60

# --- Serving ----------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8000
# When set, every request except GET /health needs "Authorization: Bearer <key>"
MCP_API_KEY=
LOG_LEVEL=INFO
