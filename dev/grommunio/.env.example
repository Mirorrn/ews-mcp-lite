# Settings for the local grommunio test server built by dev/grommunio/setup.sh.
#
#   cp dev/grommunio/.env.example .env     # .env is git-ignored
#   uv run ews-mcp-lite
#
# Logs in as alice. The passwords are the setup.sh defaults (local test data only);
# if you ran setup.sh with ALICE_PASS=..., use that value instead.
# See the root .env.example for what every variable means.

# --- Exchange (EWS) ---------------------------------------------------------
EWS_SERVER_URL=https://127.0.0.1/EWS/Exchange.asmx
EWS_EMAIL=alice@grommunio.test
EWS_USERNAME=
EWS_PASSWORD=Al1cePass!
# The dev stack uses a self-signed certificate.
EWS_INSECURE_SKIP_VERIFY=true
# setup.sh configures the server with TIMEZONE=Europe/Berlin.
EWS_TZ=Europe/Berlin
REQUEST_TIMEOUT=30

# --- Safety -----------------------------------------------------------------
# Every tool is enabled so the whole server can be exercised against test mailboxes...
EWS_CAPABILITY_TIER=full
SEND_ENABLED=true
# ...but anything sent can only go to the two test users. The stack's SMTP port is
# reachable from your network, so keep this guard set.
EWS_RECIPIENT_ALLOWLIST=*@grommunio.test
EWS_RECIPIENT_DENYLIST=
SEND_CONFIRM_SECRET=
CONFIRM_TTL_SECONDS=600

# --- Reliability ------------------------------------------------------------
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=60
WARMUP_MAX_BACKOFF_SECONDS=60

# --- Serving ----------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_API_KEY=
LOG_LEVEL=INFO
